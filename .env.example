# Copy this file to .env and fill in your values

# Supabase example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Railway example:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway"

# Local example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mbizo_accounts"

DATABASE_URL="postgresql://user:password@localhost:5432/mbizo_accounts?schema=public"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ZB Bank SmilePay — get these from https://zbnet.zb.co.zw/wallet_sandbox_merchant
ZB_API_KEY="your-zb-api-key"
ZB_API_SECRET="your-zb-api-secret"
ZB_MERCHANT_ID="your-merchant-id"
ZB_SANDBOX="true"

# Your live app URL (used for ZB webhook callback)
NEXT_PUBLIC_APP_URL="https://mbizo-accounts.vercel.app"
