generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum PaymentCategory {
  BEAM
  PLAN
  HIGHERLIFE
  CAMFED
  CHILDCARE
  SELF
}

enum AccountType {
  Cash
  Bank
}

enum UserRole {
  admin
  bursar
  cashier
}

enum PaymentMethod {
  Cash
  Bank
  ZBSmilePay
}

enum ZBPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         UserRole      @default(admin)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  sessions     Session[]
  feePayments  FeePayment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FeeType {
  id          String       @id @default(cuid())
  name        String       @unique
  amount      Decimal      @db.Decimal(12, 2)
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  feePayments FeePayment[]
}

model Student {
  id           String               @id @default(cuid())
  studentId    String               @unique
  firstName    String
  lastName     String
  form         String
  class        String
  termFee      Decimal              @db.Decimal(12, 2)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  feePayments  FeePayment[]
  transactions Transaction[]
  termBalances StudentTermBalance[]
}

model StudentTermBalance {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           String
  expectedAmount Decimal  @db.Decimal(12, 2)
  carryForward   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  @@unique([studentId, term])
}

model FeePayment {
  id          String          @id @default(cuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTypeId   String?
  feeType     FeeType?        @relation(fields: [feeTypeId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String
  bankReceipt String?
  term        String
  notes       String?
  zbPaymentId String?
  zbStatus    ZBPaymentStatus? @default(PENDING)
  createdAt   DateTime        @default(now())
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
}

model Transaction {
  id            String          @id @default(cuid())
  date          DateTime        @db.Date
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  category      PaymentCategory
  reference     String
  account       AccountType
  term          String?
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id])
  createdAt     DateTime        @default(now())
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       String
  debit         Decimal     @default(0) @db.Decimal(12, 2)
  credit        Decimal     @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
}

model ZBPayment {
  id            String          @id @default(cuid())
  zbReference   String          @unique
  studentId     String
  feeTypeId     String?
  amount        Decimal         @db.Decimal(12, 2)
  term          String
  schoolReceipt String
  status        ZBPaymentStatus @default(PENDING)
  paymentUrl    String?
  payerPhone    String?
  payerName     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}
